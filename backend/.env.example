NODE_ENV=development
PORT=4000
# Replace the host and credentials with the address and account for your PostgreSQL instance.
DATABASE_URL=postgresql://USER:PASSWORD@db.example.internal:5432/rpps?schema=public
CORS_ORIGINS=http://localhost:3000,exp://localhost:8081
AUTH_JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_FROM_A_SECURE_SECRET_MANAGER
AUTH_JWT_ISSUER=rpps-censo-api
AUTH_JWT_AUDIENCE=rpps-censo-web
# Optional OIDC bearer-token support for trusted integrations:
# OIDC_ISSUER=https://sso.example.gov.br/realms/rpps
# OIDC_AUDIENCE=rpps-censo-api
# OIDC_JWKS_URL=https://sso.example.gov.br/realms/rpps/protocol/openid-connect/certs
# OIDC_ROLES_CLAIM=realm_access.roles
PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_A_SECURE_SECRET_MANAGER
PII_LOOKUP_HMAC_KEY=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
